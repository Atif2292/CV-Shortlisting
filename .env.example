# ─────────────────────────────────────────────────────────────────────────────
# RankCV — environment variables. Copy to .env for local development.
# In production set these in your host's secrets settings. NEVER commit .env.
# The app refuses to start with APP_ENV=production until the required ones are set.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development                 # development | production
APP_URL=http://localhost:8501
APP_SECRET=                         # production: 32+ random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")

# ── Database ─────────────────────────────────────────────────────────────────
# Local default is SQLite. Production MUST use managed Postgres (Supabase, Neon, RDS…), e.g.
# DATABASE_URL=postgresql://user:password@host:5432/rankcv
DATABASE_URL=sqlite:///data/rankcv.db   # free tier default; Postgres recommended later

# ── OpenAI (Cloud AI mode) ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Email for sign-in codes (Brevo API, or any SMTP server) ──────────────────
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=                         # e.g. no-reply@yourdomain.co.uk

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                  # restricted key with read access to Customers + Subscriptions is enough
STRIPE_PRICE_IDS_PRO=               # e.g. price_123 (comma-separated if you have several)
STRIPE_PRICE_IDS_AGENCY=
STRIPE_PRO_URL=                     # Stripe Payment Link, e.g. https://buy.stripe.com/xxxx
STRIPE_AGENCY_URL=
STRIPE_PORTAL_URL=                  # Customer portal login link, e.g. https://billing.stripe.com/p/login/xxxx

# ── Plans (optional overrides) ───────────────────────────────────────────────
TRIAL_CVS=10
PRO_CVS_PER_MONTH=500
AGENCY_CVS_PER_MONTH=1500
MAX_BATCH_CVS=100
MAX_FILE_MB=10
TRIAL_REQUIRE_WORK_EMAIL=true

# ── Business details (footer + legal pages; required in production) ──────────
COMPANY_NAME=
COMPANY_NUMBER=
COMPANY_ADDRESS=
ICO_REG_NUMBER=
SUPPORT_EMAIL=
HOSTING_PROVIDER=                   # e.g. Render (Frankfurt, EU)
DATABASE_PROVIDER=                  # e.g. Supabase (London, UK)
EMAIL_PROVIDER=                     # e.g. Brevo (EU)
WHATSAPP_URL=https://wa.me/447379975532
