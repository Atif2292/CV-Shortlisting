# Paste this (filled in) into Streamlit Community Cloud → your app → Settings → Secrets.
# Never commit the real values.

APP_ENV = "production"
APP_URL = "https://your-app.streamlit.app"
APP_SECRET = ""               # 32+ random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"

# Database: leave unset to use the built-in SQLite file (free tier). Paid plans are re-read
# from Stripe, so a restart only resets usage counts and sign-in sessions.
# DATABASE_URL = "postgresql://user:password@host:5432/rankcv"

OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o"

# Sign-in code emails (Brevo free tier: 300 emails/day).
# The "From" address is picked automatically from your verified senders in Brevo.
# In Brevo, turn OFF Security → Authorised IPs, or every send from Streamlit Cloud is blocked.
BREVO_API_KEY = ""
# EMAIL_FROM = ""             # optional: force a specific verified sender

# Stripe (restricted key with READ access to Customers and Subscriptions is enough)
STRIPE_SECRET_KEY = ""
STRIPE_PRO_URL = "https://buy.stripe.com/4gM28rdxmck239y8Mk43S03"
STRIPE_AGENCY_URL = "https://buy.stripe.com/4gM00j2SIfwebG41jS43S02"
STRIPE_PORTAL_URL = ""        # Settings → Billing → Customer portal → "Login link"
# Optional: exact Price IDs. If unset, £99/month → Pro and £199/month → Agency (GBP prices).
# STRIPE_PRICE_IDS_PRO = "price_..."
# STRIPE_PRICE_IDS_AGENCY = "price_..."

# Business details (footer + legal pages)
COMPANY_NAME = ""
SUPPORT_EMAIL = ""
# COMPANY_NUMBER = ""
# COMPANY_ADDRESS = ""
# ICO_REG_NUMBER = ""
EMAIL_PROVIDER = "Brevo (Sendinblue SAS), EU"

# Free trial: refuse gmail/outlook/etc. for trials (paid customers unaffected)
TRIAL_REQUIRE_WORK_EMAIL = "true"
