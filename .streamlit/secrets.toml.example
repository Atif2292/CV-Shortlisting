# Streamlit Community Cloud → your app → Settings → Secrets. Never commit real values.

# ── Required ─────────────────────────────────────────────────────────────────
APP_SECRET = ""          # 32+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BREVO_API_KEY = ""       # Brevo → SMTP & API → API keys. Turn OFF Security → Authorised IPs in Brevo.
STRIPE_SECRET_KEY = ""   # Stripe restricted key with READ access to Customers, Subscriptions, Payment Links
OPENAI_API_KEY = ""      # keep your existing one
APP_ENV = "production"

# ── Optional ─────────────────────────────────────────────────────────────────
# STRIPE_PORTAL_URL = ""      # lets customers cancel / update cards themselves
# SUPPORT_EMAIL = "support@rankcv.io"   # contact shown on the site and legal pages
# COMPANY_NAME = "RankCV"
# COMPANY_NUMBER = ""
# COMPANY_ADDRESS = ""
# ICO_REG_NUMBER = ""
# EMAIL_FROM = ""             # force a specific Brevo sender (otherwise auto-detected)
# DATABASE_URL = ""           # Postgres, to keep usage counts across restarts
